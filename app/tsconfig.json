{
  "extends": "@canzatrade/tsconfig/esm.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "../dts/app",
    "paths": {
      "@canzatrade/backtesting": ["../packages/backtesting/src/index.ts"],
      "@canzatrade/backtesting/*": ["../packages/backtesting/src/*"],
      "@canzatrade/bot": ["../packages/bot/src/index.ts"],
      "@canzatrade/bot/*": ["../packages/bot/src/*"],
      "@canzatrade/bot-processor": ["../packages/bot-processor/src/index.ts"],
      "@canzatrade/bot-processor/*": ["../packages/bot-processor/src/*"],
      "@canzatrade/bot-templates": ["../packages/bot-templates/src/index.ts"],
      "@canzatrade/bot-templates/*": ["../packages/bot-templates/src/*"],
      "@canzatrade/db": ["../packages/db/src/index.ts"],
      "@canzatrade/db/*": ["../packages/db/src/*"],
      "@canzatrade/exchanges": ["../packages/exchanges/src/index.ts"],
      "@canzatrade/exchanges/*": ["../packages/exchanges/src/*"],
      "@canzatrade/logger": ["../packages/logger/src/index.ts"],
      "@canzatrade/logger/*": ["../packages/logger/src/*"],
      "@canzatrade/tools": ["../packages/tools/src/index.ts"],
      "@canzatrade/tools/*": ["../packages/tools/src/*"],
      "@canzatrade/trpc": ["../packages/trpc/src/index.ts"],
      "@canzatrade/trpc/*": ["../packages/trpc/src/*"],
      "@canzatrade/tsconfig/*": ["../packages/tsconfig/*"],
      "@canzatrade/types": ["../packages/types/src/index.ts"],
      "@canzatrade/types/*": ["../packages/types/src/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "files": ["package.json"],
  "references": [
    {
      "path": "../packages/backtesting"
    },
    {
      "path": "../packages/bot"
    },
    {
      "path": "../packages/bot-processor"
    },
    {
      "path": "../packages/bot-templates"
    },
    {
      "path": "../packages/db"
    },
    {
      "path": "../packages/exchanges"
    },
    {
      "path": "../packages/logger"
    },
    {
      "path": "../packages/tools"
    },
    {
      "path": "../packages/trpc"
    },
    {
      "path": "../packages/tsconfig"
    },
    {
      "path": "../packages/types"
    }
  ]
}
