# CanzaTrade Railway Deployment Dockerfile (Simple Version)
# More reliable approach without Moon docker scaffold

FROM node:18-alpine AS base

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app/package.json ./app/
COPY packages/*/package.json ./packages/*/
COPY packages/*/*/package.json ./packages/*/*/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build the application
RUN pnpm run build

# Create production image
FROM node:18-alpine AS production

ENV NODE_ENV=production
ENV PORT=3000

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nextjs -u 1001

# Copy built application and dependencies
COPY --from=base --chown=nextjs:nodejs /app/app/dist ./app/dist
COPY --from=base --chown=nextjs:nodejs /app/node_modules ./node_modules

# Copy Prisma files
COPY --from=base --chown=nextjs:nodejs /app/packages/prisma/src/schema.prisma ./packages/prisma/src/schema.prisma
COPY --from=base --chown=nextjs:nodejs /app/packages/prisma/src/migrations ./packages/prisma/src/migrations
COPY --from=base --chown=nextjs:nodejs /app/packages/prisma/seed.mjs ./packages/prisma/seed.mjs

# Copy startup scripts
COPY --chown=nextjs:nodejs bin/railway-start.sh /app/bin/railway-start.sh
RUN chmod +x /app/bin/railway-start.sh

# Create data directory
RUN mkdir -p /app/data && chown -R nextjs:nodejs /app/data

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })" || exit 1

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Run the Railway startup script
CMD ["/app/bin/railway-start.sh"]
