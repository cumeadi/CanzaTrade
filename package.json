{
  "name": "canzatrade",
  "version": "1.0.0",
  "description": "CanzaTrade - Professional Trading Platform for African Markets",
  "private": true,
  "scripts": {
    "build": "moon run :build",
    "start": "node app/dist/standalone.mjs",
    "dev": "moon run :dev",
    "lint": "moon run :lint",
    "typecheck": "moon run :typecheck",
    "prisma:migrate": "moon run prisma:migrate",
    "prisma:seed": "moon run prisma:seed",
    "vercel-build": "npm run build",
    "vercel-dev": "npm run dev"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "devDependencies": {
    "@moonrepo/cli": "^1.25.0"
  }
}
