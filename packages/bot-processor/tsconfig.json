{
  "extends": "@canzatrade/tsconfig/esm.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "../../dts/packages/bot-processor",
    "paths": {
      "@canzatrade/exchanges": ["../exchanges/src/index.ts"],
      "@canzatrade/exchanges/*": ["../exchanges/src/*"],
      "@canzatrade/indicators": ["../indicators/src/index.ts"],
      "@canzatrade/indicators/*": ["../indicators/src/*"],
      "@canzatrade/tools": ["../tools/src/index.ts"],
      "@canzatrade/tools/*": ["../tools/src/*"],
      "@canzatrade/tsconfig/*": ["../tsconfig/*"],
      "@canzatrade/types": ["../types/src/index.ts"],
      "@canzatrade/types/*": ["../types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../exchanges" },
    { "path": "../indicators" },
    { "path": "../tools" },
    { "path": "../tsconfig" },
    { "path": "../types" }
  ]
}
