{
  "extends": "@canzatrade/tsconfig/esm.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "../../dts/packages/backtesting",
    "paths": {
      "@canzatrade/bot-processor": ["../bot-processor/src/index.ts"],
      "@canzatrade/bot-processor/*": ["../bot-processor/src/*"],
      "@canzatrade/exchanges": ["../exchanges/src/index.ts"],
      "@canzatrade/exchanges/*": ["../exchanges/src/*"],
      "@canzatrade/logger": ["../logger/src/index.ts"],
      "@canzatrade/logger/*": ["../logger/src/*"],
      "@canzatrade/tools": ["../tools/src/index.ts"],
      "@canzatrade/tools/*": ["../tools/src/*"],
      "@canzatrade/tsconfig/*": ["../tsconfig/*"],
      "@canzatrade/types": ["../types/src/index.ts"],
      "@canzatrade/types/*": ["../types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../bot-processor" },
    { "path": "../exchanges" },
    { "path": "../logger" },
    { "path": "../tools" },
    { "path": "../tsconfig" },
    { "path": "../types" }
  ]
}
