{
  "extends": "@canzatrade/tsconfig/esm.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "../../dts/packages/bot",
    "paths": {
      "@canzatrade/bot-templates": ["../bot-templates/src/index.ts"],
      "@canzatrade/bot-templates/*": ["../bot-templates/src/*"],
      "@canzatrade/db": ["../db/src/index.ts"],
      "@canzatrade/db/*": ["../db/src/*"],
      "@canzatrade/event-bus": ["../event-bus/src/index.ts"],
      "@canzatrade/event-bus/*": ["../event-bus/src/*"],
      "@canzatrade/exchanges": ["../exchanges/src/index.ts"],
      "@canzatrade/exchanges/*": ["../exchanges/src/*"],
      "@canzatrade/logger": ["../logger/src/index.ts"],
      "@canzatrade/logger/*": ["../logger/src/*"],
      "@canzatrade/tools": ["../tools/src/index.ts"],
      "@canzatrade/tools/*": ["../tools/src/*"],
      "@canzatrade/tsconfig/*": ["../tsconfig/*"],
      "@canzatrade/types": ["../types/src/index.ts"],
      "@canzatrade/types/*": ["../types/src/*"],
      "@canzatrade/bot-processor": ["../bot-processor/src/index.ts"],
      "@canzatrade/bot-processor/*": ["../bot-processor/src/*"],
      "@canzatrade/trpc": ["../trpc/src/index.ts"],
      "@canzatrade/trpc/*": ["../trpc/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../bot-processor"
    },
    {
      "path": "../bot-templates"
    },
    {
      "path": "../db"
    },
    {
      "path": "../event-bus"
    },
    {
      "path": "../exchanges"
    },
    {
      "path": "../logger"
    },
    {
      "path": "../tools"
    },
    {
      "path": "../trpc"
    },
    {
      "path": "../tsconfig"
    },
    {
      "path": "../types"
    }
  ]
}
